FROM alpine:3.24 AS common

RUN ["apk", "add", \
 "bash", \
 "ccache", \
 "clang", \
 "clang-extra-tools", \
 "cmake", \
 "curl", \
 "file", \
 "gcc", \
 "git", \
 "linux-headers", \
 "ninja-build", \
 "pkgconf", \
 "python3", \
 "samurai"]

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV CC=clang CXX=clang++ SYSROOT=/sysroot
ENV PKG_CONFIG_PATH=$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/lib64/pkgconfig:$SYSROOT/usr/share/pkgconfig

ENV CFLAGS="-fPIC -O2"
ENV CXXFLAGS="$CFLAGS"

COPY toolchain/linux-static-toolchain.cmake $SYSROOT/static-toolchain.cmake

FROM common AS base

# Retry downloads that fail for a moment, e.g. GitHub's occasional HTTP 500.
# The settings apply while building this image, not in the image itself.
ARG CURL_HOME=/etc/download-retry
ARG WGETRC=/etc/download-retry/wgetrc
RUN mkdir -p /etc/download-retry \
 && printf 'retry = 5\nretry-delay = 10\nretry-connrefused\nretry-all-errors\nfail\n' >/etc/download-retry/.curlrc \
 && printf 'tries = 5\nwaitretry = 10\nretry_connrefused = on\nretry_on_http_error = 429,500,502,503,504\n' >/etc/download-retry/wgetrc

RUN ["apk", "add", \
 "autoconf", \
 "automake", \
 "bison", \
 "diffutils", \
 "flex", \
 "libtool", \
 "libxslt", \
 "make", \
 "meson", \
 "nasm", \
 "py3-mako", \
 "py3-packaging", \
 "py3-yaml", \
 "python3-dev", \
 "tcl", \
 "yasm"]

WORKDIR /opt/buildhome/build

# Build gettext at the front because it's needed by multiple paths.
RUN tar zxf <(curl -L https://ftp.gnu.org/pub/gnu/gettext/gettext-1.0.tar.gz) \
 gettext-1.0/build-aux \
 gettext-1.0/gettext-runtime \
 gettext-1.0/m4 \
 gettext-1.0/.version \
 && cd gettext-1.0/gettext-runtime \
 && ./configure --prefix="$SYSROOT/usr" --disable-shared \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /opt/buildhome/build

